{
  "name": "wa-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp transport (Baileys) for the userbot fleet: sockets, auth state in Postgres, command bus on Valkey. No business logic.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "baileys": "7.0.0-rc14",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "@types/qrcode-terminal": "0.12.2",
    "typescript": "5.9.3"
  }
}
