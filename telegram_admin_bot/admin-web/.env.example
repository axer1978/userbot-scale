# Read by server.mjs. Nothing here is secret: the admin password and every
# key stay with panel.py.

# Where panel.py listens. In docker compose: http://panel:8787
PANEL_URL=http://127.0.0.1:8787

# Where this server listens. 0.0.0.0 inside a container; keep 127.0.0.1
# anywhere else (reach it through an SSH tunnel or Caddy).
HOSTNAME=127.0.0.1
PORT=3000
