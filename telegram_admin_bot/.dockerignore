# Secrets and per-server state never go into the image. Everything else
# (the Python modules, static/ including static/owner/, migrations/) must.
.env
.env.*
data/
*.db
*.session
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
instances/
bookings.json
google-service-account.json
media/
backups/
deploy/age-recipient.txt
# The WhatsApp gateway is its own image (wa_gateway/Dockerfile); its sources
# and node_modules never belong in the Python image.
wa_gateway/
