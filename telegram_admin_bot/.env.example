# Variables read by the docker compose stack (docker-compose.yml). The real
# .env sits next to docker-compose.yml and is never committed.
#
# Don't fill the secrets in by hand. Generate them on the server with the
# one-liner from DEPLOY_TODAY.md (step 4), in this folder:
#
#   umask 077
#   python3 -c "import secrets,base64;print('USERBOT_MASTER_KEY='+base64.b64encode(secrets.token_bytes(32)).decode());print('ADMIN_PASSWORD='+secrets.token_urlsafe(24));print('POSTGRES_PASSWORD='+secrets.token_urlsafe(24));print('ADMIN_TOTP_SECRET='+base64.b32encode(secrets.token_bytes(20)).decode())" > .env
#
# Then append any of the optional settings below that you need (for a
# public panel: PANEL_DOMAIN and COMPOSE_PROFILES).
#
# Telegram API ID/hash, phone numbers and DeepSeek keys do NOT go here. You
# enter them per account in the panel ("+ Add account"), and they are stored
# encrypted in Postgres.

# --- Required -------------------------------------------------------------

# Base64 of 32 random bytes. Encrypts every stored login and API key (AES-GCM).
# Lose it and all stored logins become unreadable. Back it up.
USERBOT_MASTER_KEY=

# Shared password for the admin panel. The panel refuses to start without it,
# and with PANEL_DOMAIN set, unless it has at least 14 characters.
ADMIN_PASSWORD=

# Postgres password. Only takes effect when the database volume is first
# created, so changing it later needs the old one. If empty, it falls back to
# a publicly known default.
POSTGRES_PASSWORD=

# --- Optional ---------------------------------------------------------------

# Postgres user and database name (default: userbot / userbot). Like the
# password, these are fixed once the database has been created.
# POSTGRES_USER=userbot
# POSTGRES_DB=userbot

# Worker processes in the manager, and accounts per worker (default 2 x 25).
# WORKER_COUNT=2
# SESSIONS_PER_WORKER=25

# Log level of the WhatsApp transport (wa-gateway): fatal, error, warn, info
# (default), debug, trace. At trace the WhatsApp library prints decoded
# frames, which can include message text.
# WA_GATEWAY_LOG_LEVEL=info

# Public HTTPS through the optional `caddy` service (profile "public"): a domain
# whose A record points at this server, or, with no domain, the free
# <ip-with-dashes>.sslip.io name (server 1.2.3.4 -> 1-2-3-4.sslip.io).
# PANEL_DOMAIN=1-2-3-4.sslip.io
# Which optional services plain `docker compose up -d` starts:
#   public                  the panel on PANEL_DOMAIN (Caddy, ports 80/443)
#   public,booking-pages    that, plus the booking pages on BOOKING_DOMAIN
#   booking-only            the booking pages alone, no public panel
# COMPOSE_PROFILES=public

# Two-factor login for the panel: a base32 secret for an authenticator app.
# Required when PANEL_DOMAIN is set. The one-liner at the top makes one; to
# make just a new one (the panel need not be running):
#   python3 -c "import secrets,base64;print('ADMIN_TOTP_SECRET='+base64.b32encode(secrets.token_bytes(20)).decode())"
# ADMIN_TOTP_SECRET=

# DeepSeek key for the panel's own LLM calls, not any client's: the "Ask AI"
# config helper in the Clients view. Its cost is counted as platform spend.
# Without it that helper is unavailable; everything else works.
# DEEPSEEK_PLATFORM_KEY=

# Booking pages (optional; COMPOSE_PROFILES=public,booking-pages, or
# booking-only): the public calendar feed per client and the read-only page
# per booking. BOOKING_DOMAIN must point at this server (with sslip.io:
# book.1-2-3-4.sslip.io); PUBLIC_BASE_URL is how links to it are written
# (reminders, the panel's calendar link). Leave both empty to keep them off.
# BOOKING_DOMAIN=book.1-2-3-4.sslip.io
# PUBLIC_BASE_URL=https://book.1-2-3-4.sslip.io

# E-mail record of each booking confirmation, change and cancellation, sent
# to booking.owner_email. Empty SMTP_HOST = no e-mail. SMTP_SECURITY is
# starttls (default, port 587), ssl (port 465) or none.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_SECURITY=starttls

# Photos (vision.* in a client's config): DeepSeek cannot see images, so they
# go to a separate OpenAI-compatible chat-completions endpoint that can
# (OpenAI, OpenRouter, Gemini's OpenAI-compatible URL, ...). The model name
# is vision.model in the client's config; add its price under Clients ->
# Platform rules -> AI prices.
# VISION_API_URL=https://api.openai.com/v1/chat/completions
# VISION_API_KEY=

# Google Calendar mirror for bookings: path INSIDE the container to a service
# account JSON key (put the file under ./data). Default:
# /app/data/tenants/<client id>/google-service-account.json if that exists.
# GOOGLE_SERVICE_ACCOUNT_FILE=/app/data/google-service-account.json

# Alerts for the operator (Safety -> Alerts in the panel): also e-mailed to
# ALERT_EMAIL (needs the SMTP_* settings above) and/or POSTed as JSON to
# ALERT_WEBHOOK_URL ({"text", "content", "kind", "severity", "tenant", ...}).
# Empty = panel only.
# ALERT_EMAIL=
# ALERT_WEBHOOK_URL=
