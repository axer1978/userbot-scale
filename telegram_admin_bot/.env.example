# You normally don't need to touch this file.
#
# Run  python main.py  (or start.bat on Windows): the panel opens in your
# browser and asks for these on a sign-in screen the first time, then saves
# them to a .env next to this file. Never commit the real .env.
#
# Filling this in by hand still works, for headless servers:
#   cp .env.example .env   then edit, or run   python setup_session.py

# Telegram API credentials from https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash_here

# Telethon StringSession for the account the assistant runs on.
# The sign-in screen (or setup_session.py) writes this for you.
SESSION=your_telethon_string_session_here

# DeepSeek API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional — only for mirroring bookings into Google Calendar. Path to the
# service account JSON key (see google_calendar.py for the setup steps).
# Defaults to google-service-account.json next to main.py if that exists.
GOOGLE_SERVICE_ACCOUNT_FILE=
